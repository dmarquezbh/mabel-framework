// =============================================================================
// mabel:sdui — descritor semântico de UI (north star, Component Model-flavored).
//
// Espelha Mabel.Wasi.Protocol/Sdui/*.cs. É o CONTRATO SEMÂNTICO platform-neutral:
// o guest descreve CONTROLES; cada host mapeia pra widgets nativos (UIKit no iOS).
//
// ⚠️ IMPORTANTE — igual ao mabel:capabilities: este WIT NÃO é compilado por
// wit-bindgen hoje. O transporte real v2 é JSON (SduiJson: camelCase, enums como
// número, omite null), lido pelo host Swift (MabelSdui.swift). O WIT documenta a
// forma canônica e prepara um transporte binário WASI futuro sem mudar o modelo.
//
// Cobertura Onda 1 — fundacionais do schema (v2):
//   • versionamento + degradação graciosa (unknown-fallback, min-schema-version)
//   • acessibilidade (a11y)
//   • layout responsivo/adaptativo (size-class, breakpoints, flexbox, safe-area)
//   • listas virtualizadas (list-data + item-template + bind)
//   • navegação declarativa (nav-stack, nav, navigate)
//
// Cobertura Onda 🟡 — funcional (v3):
//   • theming / dark-mode (theme-set, tokens de cor/tipografia/espaçamento)
//   • i18n / l10n (localization: locale → chave → template)
//   • forms + validação (text-field/select/checkbox/switch/slider/stepper,
//     validation-rule, option)
//   • catálogo ampliado (tab-bar, grid, sheet, avatar, chip)
//   • media (video/audio + media metadata)
//   • animações declarativas (animation) + transições de navegação
//   • lifecycle (on-appear/on-disappear) + tabs
// =============================================================================

package mabel:sdui@0.3.0;

interface descriptor {
    // ── Primitivos ────────────────────────────────────────────────────────────

    /// Cor RGBA empacotada 0xRRGGBBAA (mesmo formato do render-command).
    type rgba = u32;

    /// Par chave/valor (mapas achatados; JSON vira objeto).
    record kv {
        key: string,
        value: string,
    }

    /// Insets top/right/bottom/left em px lógicos.
    record edges {
        top: f32,
        right: f32,
        bottom: f32,
        left: f32,
    }

    // ── Enums de layout/estilo ──────────────────────────────────────────────────

    enum node-type {
        // v1/v2
        screen, vstack, hstack, scroll-view, list, card, text, button,
        image, badge, progress-bar, divider, spacer, nav-stack,
        // v3 (Onda 🟡)
        text-field, select, checkbox, switch, slider, stepper, tab-bar,
        grid, sheet, avatar, chip, video, audio,
    }

    enum axis { vertical, horizontal }
    enum align { start, center, end, stretch }
    enum font-weight { regular, medium, semibold, bold }
    enum wrap { no-wrap, wrap }
    enum size-class { any, compact, regular }
    enum keyboard-type { default, number, email, phone, url, decimal }

    /// Bordas do safe-area respeitadas por um container.
    flags safe-area { top, right, bottom, left }

    // ── Degradação graciosa (OTA) ─────────────────────────────────────────────────

    /// O que o host faz com um nó que não reconhece (type novo, ou
    /// min-schema-version acima da versão dele).
    enum unknown-fallback {
        /// Renderiza os filhos como container transparente (default do contrato).
        render-children,
        /// Placeholder visível "não suportado" (dev/HML).
        placeholder,
        /// Pula o nó e a subárvore silenciosamente.
        ignore,
    }

    // ── Acessibilidade ────────────────────────────────────────────────────────────

    enum a11y-role {
        none, button, header, link, image, text, adjustable, search,
        summary, toggle, progress-indicator,
    }

    flags a11y-traits {
        selected, disabled, updates-frequently, plays-sound,
        starts-media-session, causes-page-turn,
    }

    record a11y {
        label: option<string>,
        role: option<a11y-role>,
        hint: option<string>,
        hidden: option<bool>,
        value: option<string>,
        traits: option<a11y-traits>,
    }

    // ── Navegação ───────────────────────────────────────────────────────────────

    enum nav-kind { push, pop, replace, root, pop-to }
    enum nav-transition { default, none, fade, slide-up, push }

    record navigate {
        kind: nav-kind,
        route: option<string>,
        params: option<list<kv>>,
        // v3: estilo visual da transição.
        transition: option<nav-transition>,
    }

    record nav {
        route: option<string>,
        title: option<string>,
        modal: option<bool>,
        hides-nav-bar: option<bool>,
    }

    // v3: uma aba de um tab-bar.
    record tab {
        route: string,
        label: option<string>,
        label-key: option<string>,
        icon: option<string>,
        badge: option<string>,
    }

    // ── Theming / dark-mode (v3) ────────────────────────────────────────────────

    enum theme-mode { system, light, dark }

    record text-style {
        font-size: option<f32>,
        weight: option<font-weight>,
        color: option<rgba>,
        color-token: option<string>,
    }

    /// token → valor. Uma variante de tema (clara OU escura).
    record theme {
        colors: option<list<tuple<string, rgba>>>,
        text: option<list<tuple<string, text-style>>>,
        spacing: option<list<tuple<string, f32>>>,
    }

    record theme-set {
        light: option<theme>,
        dark: option<theme>,
    }

    // ── i18n / l10n (v3) ────────────────────────────────────────────────────────

    /// locale → (chave → template com placeholders {nome}).
    record localization {
        default-locale: option<string>,
        locales: list<tuple<string, list<kv>>>,
    }

    // ── Forms + validação (v3) ──────────────────────────────────────────────────

    record option-item {
        value: string,
        label: option<string>,
        label-key: option<string>,
    }

    enum validation-kind { required, min-length, max-length, pattern, min, max, email }

    record validation-rule {
        kind: validation-kind,
        param: option<string>,
        message: option<string>,
        message-key: option<string>,
    }

    // ── Media (v3) ──────────────────────────────────────────────────────────────

    enum content-fit { cover, contain, fill }

    record media {
        autoplay: option<bool>,
        loop: option<bool>,
        muted: option<bool>,
        controls: option<bool>,
        poster: option<string>,
        fit: option<content-fit>,
    }

    // ── Animação (v3) ─────────────────────────────────────────────────────────────

    enum animation-kind { none, fade, slide, scale, expand }
    enum animation-trigger { on-appear, on-tap, continuous }
    enum easing { linear, ease-in, ease-out, ease-in-out, spring }
    enum slide-from { bottom, top, leading, trailing }

    record animation {
        kind: animation-kind,
        trigger: option<animation-trigger>,
        duration-ms: option<u32>,
        delay-ms: option<u32>,
        easing: option<easing>,
        direction: option<slide-from>,
    }

    // ── Ação semântica ────────────────────────────────────────────────────────────

    record action {
        name: string,
        args: option<list<kv>>,
        navigate: option<navigate>,
    }

    // ── Props ─────────────────────────────────────────────────────────────────────

    record props {
        // layout
        spacing: option<f32>,
        padding: option<edges>,
        align: option<align>,
        width: option<f32>,
        height: option<f32>,
        flex: option<f32>,
        axis: option<axis>,
        // box
        background: option<rgba>,
        corner-radius: option<f32>,
        border-color: option<rgba>,
        border-width: option<f32>,
        // texto
        text: option<string>,
        font-size: option<f32>,
        color: option<rgba>,
        weight: option<font-weight>,
        // imagem
        src: option<string>,
        // progress
        value: option<f32>,
        // layout responsivo / flexbox refinado
        min-width: option<f32>,
        max-width: option<f32>,
        min-height: option<f32>,
        max-height: option<f32>,
        aspect-ratio: option<f32>,
        flex-grow: option<f32>,
        flex-shrink: option<f32>,
        flex-basis: option<f32>,
        wrap: option<wrap>,
        safe-area: option<safe-area>,
        // dados semânticos
        data: option<list<kv>>,

        // ── v3 (Onda 🟡) ─────────────────────────────────────────────────────
        // theming: referências a tokens do tema ativo.
        background-token: option<string>,
        color-token: option<string>,
        border-color-token: option<string>,
        text-style: option<string>,
        spacing-token: option<string>,
        // i18n.
        text-key: option<string>,
        text-args: option<list<kv>>,
        // forms / inputs.
        field: option<string>,
        placeholder: option<string>,
        placeholder-key: option<string>,
        default-value: option<string>,
        checked: option<bool>,
        multiline: option<bool>,
        secure: option<bool>,
        keyboard: option<keyboard-type>,
        options: option<list<option-item>>,
        min: option<f32>,
        max: option<f32>,
        step: option<f32>,
        disabled: option<bool>,
        // catálogo ampliado.
        columns: option<u32>,
        presented: option<bool>,
    }

    /// Variação condicional de props por classe de tamanho / breakpoint.
    record responsive-override {
        width-class: option<size-class>,
        height-class: option<size-class>,
        min-container-width: option<f32>,
        props: props,
    }

    // ── Listas virtualizadas ────────────────────────────────────────────────────

    record list-item {
        id: string,
        data: option<list<kv>>,
        on-tap: option<action>,
    }

    record list-data {
        item-template: node,
        items: option<list<list-item>>,
        virtualized: bool,
        axis: option<axis>,
        estimated-item-extent: option<f32>,
        count: option<u32>,
        window-start: option<u32>,
    }

    // ── Nó + documento ────────────────────────────────────────────────────────────

    record node {
        id: string,
        %type: node-type,
        props: option<props>,
        children: option<list<node>>,
        on-tap: option<action>,
        a11y: option<a11y>,
        fallback: option<unknown-fallback>,
        min-schema-version: option<u32>,
        responsive: option<list<responsive-override>>,
        list: option<list-data>,
        nav: option<nav>,
        bind: option<list<kv>>,
        // ── v3 (Onda 🟡) ─────────────────────────────────────────────────────
        animation: option<animation>,
        media: option<media>,
        validation: option<list<validation-rule>>,
        tabs: option<list<tab>>,
        on-appear: option<action>,
        on-disappear: option<action>,
    }

    record document {
        schema-version: u32,
        root: node,
        // ── v3 (Onda 🟡) ─────────────────────────────────────────────────────
        themes: option<theme-set>,
        theme-mode: option<theme-mode>,
        localization: option<localization>,
    }
}
