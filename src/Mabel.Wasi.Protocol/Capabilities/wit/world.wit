// =============================================================================
// world mabel-capabilities — o contrato guest ↔ host para APIs nativas.
//
// O guest (app .NET→WASM, sandbox) IMPORTA as capabilities customizadas + as
// interfaces WASI padrão que o SDK do .NET já provê. O host provê os imports e
// chama de volta o export `on-capability-result` para entregar resultados async.
//
// Contrato PLATFORM-NEUTRAL: dois hosts co-iguais consomem este mesmo WIT —
// shell Swift (WasmKit, interpretado) no iOS e shell Kotlin/Java (wasmtime-JNI
// ou Chicory, com JIT) no Android. O guest é o mesmo binário nos dois; o runtime
// WASM e a API nativa são detalhe interno de cada host. Ver docs §3.1 e §5.
//
// ── Divisão WASI-padrão vs custom (detalhe em docs/capabilities-abi.md) ──
//   REUSA WASI padrão (o wasi-wasm workload do .NET já linka): filesystem,
//   clocks, random, sockets/http, cli/stdio+environment. NÃO reimplementamos.
//   CUSTOM (WASI não tem): câmera, galeria, GPS, notificações, biometria,
//   secure-storage, share, clipboard, haptics, bluetooth (BLE) — as interfaces
//   deste pacote.
//
// ── Assincronia (ADR 0002 one-shot; ADR 0003 stream) ──
//   Sem futures do Component Model (WasmKit/componentize-dotnet não têm p2
//   sólido). Dois padrões achatados sobre core-module p1:
//   • ONE-SHOT: request-id + on-capability-result (uma chamada → um resultado).
//   • STREAM:   subscription-id + on-capability-event (N eventos) + unsubscribe.
//   Segue a descrição do one-shot abaixo; o stream é irmão dele.
//   Padrão = request-id + callback: o guest chama import(request-id,…)
//   que retorna JÁ (aceito/negado); o trabalho nativo roda async; o host chama
//   o export on-capability-result(request-id,…) quando termina.
// =============================================================================

package mabel:capabilities@0.2.0;

world mabel-capabilities {
    // ── Interfaces WASI padrão que o guest também usa (providas pelo SDK) ──
    // Declaradas como referência do contrato; o runtime as satisfaz via WASI p1.
    //   import wasi:filesystem/types@0.2.x;
    //   import wasi:clocks/wall-clock@0.2.x;
    //   import wasi:random/random@0.2.x;
    //   import wasi:sockets/tcp@0.2.x;   // ou wasi:http/outgoing-handler
    //   import wasi:cli/environment@0.2.x;
    // (comentadas: no lowering p1 atual elas entram pelos imports wasi_snapshot
    //  padrão, não por este world.)

    // ── Capabilities CUSTOM importadas pelo guest ──
    import types;
    import permissions;
    import streaming;
    import camera;
    import location;
    import notifications;
    import biometrics;
    import secure-storage;
    import share;
    import clipboard;
    import haptics;
    import bluetooth;

    // ── Export do guest: callback ÚNICO de resultado ONE-SHOT ──
    // O host chama isto para entregar o resultado de qualquer chamada async
    // (câmera, GPS one-shot, permissão, biometria, share, connect BLE…). O guest
    // despacha por request-id + capability. Um único ponto de entrada mantém o
    // wire simples e casa com o lowering achatado (CapabilityContract.OnCapabilityResult).
    export on-capability-result: func(result: types.cap-result);

    // ── Export do guest: callback de EVENTO de STREAM (ADR 0003) ──
    // O host chama isto N vezes por assinatura ativa (scan BLE, notify de
    // característica, GPS contínuo, notificações recebidas…), até o guest chamar
    // streaming.unsubscribe. Roteado por subscription-id + capability + event-kind.
    export on-capability-event: func(event: types.cap-event);
}
